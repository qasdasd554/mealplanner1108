# ══════════════════════════════════════════════════════════════════
# SZABLON KONFIGURACJI — skopiuj jako .env do pracy lokalnej.
#
# NIGDY nie wpisuj tu prawdziwych haseł ani nie commituj pliku .env.
# Na produkcji ustaw te wartości w panelu Render:
#   Dashboard → twoja usługa → Environment → Environment Variables
#
# (Poprzednia wersja tego pliku zawierała prawdziwe hasło do bazy Neon
#  i prawdziwy sekret JWT — dlatego backend ma teraz .gitignore.)
# ══════════════════════════════════════════════════════════════════

# ── Środowisko ────────────────────────────────────────────────────
# "production" (domyślnie) wymaga ustawienia SECRET_KEY i DATABASE_URL —
# bez nich aplikacja celowo nie wystartuje.
# Do pracy lokalnej ustaw: development
ENVIRONMENT=development

# ── Baza danych (Neon) ────────────────────────────────────────────
# Connection string skopiuj z panelu Neon. Sterownik musi być asyncpg:
#   postgresql+asyncpg://user:haslo@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_meal_planner

# ── JWT ───────────────────────────────────────────────────────────
# Wygeneruj:  openssl rand -hex 32
# Minimum 32 znaki — krótszy zostanie odrzucony na produkcji.
SECRET_KEY=
ALGORITHM=HS256
# 30 dni. Krótszy czas życia powodował częste wylogowywanie z aplikacji.
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ── Logowanie przez Google ────────────────────────────────────────
# Client ID typu "Web application" z Google Cloud Console.
# Musi być identyczny z googleWebClientId w lib/config/api_config.dart.
GOOGLE_WEB_CLIENT_ID=780793039743-6ap1jq18i31hqt04pf7gj8i4jip67uts.apps.googleusercontent.com

# ── API ───────────────────────────────────────────────────────────
# WAŻNE: musi być "/api/v1" — tego oczekuje aplikacja Flutter.
API_V1_PREFIX=/api/v1

# ── CORS ──────────────────────────────────────────────────────────
# Dotyczy WYŁĄCZNIE wersji webowej (aplikacja mobilna nie wysyła Origin).
# Podaj konkretne domeny po przecinku, np.:
#   CORS_ORIGINS=https://mojaaplikacja.pl,https://www.mojaaplikacja.pl
# "*" oznacza dowolną domenę — do produkcji webowej nie zalecane.
CORS_ORIGINS=*

# ── Limity zapytań (ochrona przed łamaniem haseł) ─────────────────
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_SIGNUP_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=300

# ── Redis (obecnie nieużywane) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
